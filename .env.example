# =================================================================
# PROCTORCODE ENVIRONMENT CONFIGURATION
# =================================================================

# ----------------- DATABASE SETTINGS -----------------
# 1. Local SQLite (Default, no configuration needed):
# Leave DATABASE_URL commented out to automatically use local SQLite:
# DATABASE_URL=

# 2. Supabase PostgreSQL (Cloud Database):
# Copy the URI from Supabase: Project Settings -> Database -> Connection string -> URI
# Replace [YOUR-PASSWORD] with your actual Supabase database password:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# Or using the connection pooler on port 6543:
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# ----------------- SUPABASE STORAGE (OPTIONAL) -----------------
# Copy from Supabase: Project Settings -> API
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_KEY=[YOUR-SUPABASE-ANON-OR-SERVICE-ROLE-KEY]
SUPABASE_BUCKET=quiz-documents

# ----------------- SERVER & SECURITY SETTINGS -----------------
PORT=8000
HOST=127.0.0.1
SECRET_KEY=super-secret-secure-proctor-quiz-key-2026
